<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ generated_at }}</title>
<style>
:root { --bg:#fafaf9; --fg:#1c1917; --muted:#78716c; --card:#fff; --line:#e7e5e4; --accent:#2563eb; --tag:#f5f5f4; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#141414; --fg:#e7e5e4; --muted:#a8a29e; --card:#1c1c1c; --line:#2e2e2e; --accent:#60a5fa; --tag:#262626; }
}
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif; }
main { max-width: 920px; margin: 0 auto; padding: 24px 16px 64px; }
h1 { font-size: 22px; margin: 0 0 4px; }
.meta { color: var(--muted); font-size: 13px; margin-bottom: 20px; }
.summary { display:flex; flex-wrap:wrap; gap:8px; margin-bottom: 24px; }
.summary span { background: var(--tag); border:1px solid var(--line); border-radius: 999px; padding: 2px 10px; font-size: 13px; }
h2 { font-size: 16px; margin: 28px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
li { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; }
li a.title { color: var(--accent); font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
li a.title:hover { text-decoration: underline; }
.url { color: var(--muted); font-size: 12px; overflow-wrap: anywhere; margin-top: 2px; }
.snippet { margin: 6px 0 0; }
.tags { margin-top: 6px; display:flex; flex-wrap: wrap; gap: 6px; font-size: 12px; color: var(--muted); }
.tags span { background: var(--tag); border-radius: 4px; padding: 0 6px; }
.empty { color: var(--muted); }
.tags span.v-unclear { background: #fef3c7; color: #92400e; }
details.rejected { margin-top: 32px; color: var(--muted); }
details.rejected summary { cursor: pointer; font-weight: 600; }
details.rejected li { padding: 8px 12px; }
@media (prefers-color-scheme: dark) {
  .tags span.v-unclear { background: #422006; color: #fcd34d; }
}
</style>
</head>
<body>
<main>
  <h1>{{ title }}</h1>
  <div class="meta">{{ t("meta.generated", at=generated_at) }}{% if period %} · {{ period }}{% endif %} · {{ t("meta.links", n=total) }}{% if rejected %} · {{ t("meta.rejected", n=rejected|length) }}{% endif %}{% if unclassified %} · {{ t("meta.unclassified", n=unclassified) }}{% endif %}</div>
  <div class="summary">
    {% for group in groups %}<span>{{ t("group." ~ group.key) }}: {{ group.mentions|length }}</span>{% endfor %}
  </div>
  {% for group in groups %}
  <h2>{{ t("group." ~ group.key) }} ({{ group.mentions|length }})</h2>
  <ol>
    {% for m in group.mentions %}
    <li>
      <a class="title" href="{{ m.original_url }}" target="_blank" rel="noopener noreferrer">{{ m.title or m.domain }}</a>
      <div class="url">{{ m.original_url }}</div>
      {% if m.snippet %}<p class="snippet">{{ m.snippet }}</p>{% endif %}
      <div class="tags">
        {% if m.verdict == 'unclear' %}<span class="v-unclear" title="{{ m.verdict_reason or '' }}">{{ t("tag.unclear") }}</span>{% endif %}

        <span>{{ m.domain }}</span>
        {% if m.published_at %}<span>{{ t("tag.published", d=m.published_at.strftime('%Y-%m-%d')) }}</span>{% endif %}
        <span>{{ t("tag.found", d=m.first_seen_at.strftime('%Y-%m-%d')) }}</span>
        {% for p in m.providers %}<span>{{ p }}</span>{% endfor %}
      </div>
    </li>
    {% endfor %}
  </ol>
  {% endfor %}
  {% if not total %}<p class="empty">{{ t("empty") }}</p>{% endif %}
  {% if rejected %}
  <details class="rejected">
    <summary>{{ t("rejected_block", n=rejected|length) }}</summary>
    <ol>
      {% for m in rejected %}
      <li><a href="{{ m.original_url }}" target="_blank" rel="noopener noreferrer">{{ m.title or m.domain }}</a>
        <div class="url">{{ m.domain }} — {{ m.verdict_reason }}</div></li>
      {% endfor %}
    </ol>
  </details>
  {% endif %}
</main>
</body>
</html>
