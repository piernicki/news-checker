# Copy to .env next to config.yaml and fill in. An empty key means the provider or feature is skipped.

# Search providers: https://serper.dev, https://brave.com/search/api/
SERPER_API_KEY=
BRAVE_API_KEY=
# Yandex Cloud: API key of a service account (starts with AQVN) and the folder id (starts with b1g)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# LLM filter: https://platform.claude.com
ANTHROPIC_API_KEY=

# Telegram bot for reports: token from @BotFather, chat id from `news-checker tg-bot-chats`
TG_BOT_TOKEN=
TG_CHAT_ID=
